{
  "dataset": "data/jst-r6-global-gbp.json",
  "firstStartYear": 1950,
  "retirementLengths": [25, 30, 35],

  "defaults": {
    "pot": 500000,
    "age": 60,
    "years": 30,
    "wanted": 22500,
    "minimum": 18000,
    "incomeChange": null,
    "otherIncome": [],
    "riskShare": 0.05,
    "annualFee": 0.0025
  },

  "statePension": {
    "taxYear": "2026/27",
    "weekly": 241.30,
    "annual": 12547.60,
    "age": 67,
    "source": "https://www.carehome.co.uk/advice/what-will-the-uk-state-pension-be-in-2026"
  },
  "displayInflation": 0.025,

  "currentMixes": [
    { "label": "60/30/10", "equities": 0.6, "bonds": 0.3, "cash": 0.1 },
    { "label": "70/20/10", "equities": 0.7, "bonds": 0.2, "cash": 0.1 },
    { "label": "80/10/10", "equities": 0.8, "bonds": 0.1, "cash": 0.1 },
    { "label": "60/40/0", "equities": 0.6, "bonds": 0.4, "cash": 0 },
    { "label": "70/30/0", "equities": 0.7, "bonds": 0.3, "cash": 0 },
    { "label": "50/25/25", "equities": 0.5, "bonds": 0.25, "cash": 0.25 }
  ],
  "defaultMix": "60/30/10",

  "risk": {
    "choices": [
      { "share": 0, "label": "None" },
      { "share": 0.05, "label": "About 1 in 20" },
      { "share": 0.1, "label": "About 1 in 10" }
    ],
    "rankYears": 10,
    "subsetSize": 10
  },

  "thresholds": {
    "nearlyRanOutYears": 1,
    "incomeTolerance": 1
  },

  "grid": {
    "mixes": [0.6, 0.7, 0.8, 0.9, 1.0],
    "cashBufferYears": [0, 2, 5, 10],
    "strategies": [
      { "strategy": "constant-real", "rates": [0.03, 0.035, 0.04, 0.045, 0.05] },
      { "strategy": "fixed-percentage", "rates": [0.04, 0.045, 0.05, 0.055] },
      { "strategy": "guyton-klinger", "rates": [0.04, 0.045, 0.05, 0.055, 0.06] },
      { "strategy": "floor-ceiling", "rates": [0.04, 0.045, 0.05, 0.055], "floorPct": [0.9, 1.0], "ceilingPct": [1.5] }
    ]
  },

  "cashReserve": {
    "floorYears": 1,
    "targetYears": 2,
    "maxYears": 3,
    "phaseInYears": 5,
    "downturnDrop": 0.1
  },

  "guytonKlinger": {
    "guardrail": 0.2,
    "adjustment": 0.1,
    "inflationCap": 0.06,
    "noCutFinalYears": 15,
    "skipOnlyIfAboveStartRate": true
  },

  "presets": [
    { "id": "typical", "label": "Typical retirement", "values": { "pot": 500000, "years": 30, "wanted": 22500, "minimum": 18000, "riskShare": 0.05 } },
    { "id": "nothing-runs-out", "label": "Nothing may run out", "values": { "pot": 500000, "years": 30, "wanted": 22500, "minimum": 18000, "riskShare": 0 } },
    { "id": "modest", "label": "Modest income", "values": { "pot": 500000, "years": 30, "wanted": 17500, "minimum": 15000, "riskShare": 0.05 } },
    { "id": "early", "label": "Retiring early", "values": { "pot": 500000, "years": 35, "wanted": 20000, "minimum": 16000, "riskShare": 0.05 } },
    { "id": "can-vary", "label": "Income can vary", "values": { "pot": 500000, "years": 30, "wanted": 22500, "minimum": 15000, "riskShare": 0.05 } },
    { "id": "too-much", "label": "Asking for too much", "values": { "pot": 500000, "years": 30, "wanted": 35000, "minimum": 32000, "riskShare": 0 } },
    { "id": "change", "label": "Income changes later", "values": { "pot": 500000, "years": 30, "wanted": 26000, "minimum": 20000, "riskShare": 0.05, "incomeChange": { "fromYear": 11, "wanted": 20000, "minimum": 16000 } } }
  ]
}
